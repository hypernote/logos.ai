#!/bin/bash
# logos — terminal coding assistant backed by local Ollama

# Resolve symlinks portably across macOS and Linux
_resolve() {
  local target="$1"
  if command -v realpath &>/dev/null; then
    realpath "$target"
  elif command -v readlink &>/dev/null; then
    # macOS readlink does not support -f without coreutils; follow manually
    local dir file
    dir="$(cd "$(dirname "$target")" && pwd -P)"
    file="$(basename "$target")"
    local link
    while link="$(readlink "$dir/$file" 2>/dev/null)"; do
      case "$link" in
        /*) dir="$(dirname "$link")"; file="$(basename "$link")" ;;
        *)  dir="$(cd "$dir" && cd "$(dirname "$link")" && pwd -P)"; file="$(basename "$link")" ;;
      esac
    done
    echo "$dir/$file"
  else
    python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$target"
  fi
}

REAL_SCRIPT="$(_resolve "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PROJECT_DIR/.env"

# Load .env
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

MODEL="${MODEL:-gemma3:4b}"
OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://localhost:11434}"

# Detect OS for any platform-specific behaviour
OS="$(uname -s)"

# Check python3
if ! command -v python3 &>/dev/null; then
  echo "ERROR: python3 is required."
  case "$OS" in
    Darwin) echo "Install with: brew install python" ;;
    Linux)  echo "Install with: sudo apt install python3" ;;
  esac
  exit 1
fi

# Set up virtualenv if missing
VENV="$PROJECT_DIR/.venv"
if [[ ! -d "$VENV" ]]; then
  echo "Setting up Logos environment..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$PROJECT_DIR/requirements.txt"
fi

exec "$VENV/bin/python" "$PROJECT_DIR/logos_cli/main.py" \
  --model "$MODEL" \
  --ollama-url "$OLLAMA_BASE_URL" \
  --profiles-dir "$PROJECT_DIR/profiles" \
  "$@"
